<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skin365</title>
    <link rel="stylesheet" href="/css/index.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
      <div class="page-container">
        <header>
         <%- include('partials/header') %>
        </header>

    <div class="container mt-4">
        <h3 class="mb-4">Danh sách sản phẩm </h3>
        
        <div id="product-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 15px;">
            <% if (products.length > 0) { %>
                <% products.forEach(p => { %>
                    <div class="card h-100 shadow-sm border-0 position-relative" >
                        <% if (p.sale_percent > 0) { %>
                        <div class="badge bg-danger position-absolute" style="top:8px; left:8px;">
                            -<%= p.sale_percent %>%
                        </div>
                        <% } %>
                        <img src="<%= p.image_url %>" class="card-img-top" alt="<%= p.name %>" style="height: 160px; object-fit: cover;">
                        <div class="card-body p-2 text-center">
                            <p class="card-title mb-1 fw-bold" style="font-size: 14px;"><%= p.name %></p>
                            <% if (p.sale_percent > 0) { %>

                                <p class="text-muted small mb-0" style="text-decoration: line-through;">
                                <%= Number(p.price).toLocaleString() %>đ
                                </p>

                                <p class="text-danger fw-bold small">
                                <%= Number(p.price * (100 - p.sale_percent) / 100).toLocaleString() %>đ
                                </p>

                                <% } else { %>

                                <p class="text-danger fw-bold small">
                                <%= Number(p.price).toLocaleString() %>đ
                                </p>

                                <% } %>
                            
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>Hiện tại danh mục này chưa có sản phẩm nào.</p>
            <% } %>
        </div>
    </div>
    <footer>
         <%- include('partials/footer') %>
    </footer>
    </div>
</body>
</html>