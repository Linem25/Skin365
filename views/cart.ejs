<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giỏ hàng - Skin365</title>
    <link rel="stylesheet" href="/css/index.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="page-container">
        <%- include('partials/header') %>

        <div class="container mt-4">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>
    
    <!-- Row chính chứa 2 cột -->
    <div class="row g-4"> 
        
        <!-- CỘT TRÁI: Danh sách sản phẩm (Chiếm 8/12 phần) -->
        <div class="col-lg-8">
            <div id="cart-items-list">
                <!-- JS render sản phẩm vào đây -->
            </div>
        </div>

        <!-- CỘT PHẢI: Tổng tiền & Form (Chiếm 4/12 phần) -->
        <div class="col-lg-4">
            <div class="card p-3 shadow-sm border-0" style="position: sticky; top: 100px;">
                <h4 class="fw-bold">Tổng cộng</h4>
                <hr>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Thành tiền:</span>
                    <span id="total-price" class="fw-bold text-danger fs-5">0đ</span>
                </div>

                <!-- Form thông tin (Ẩn mặc định) -->
                <div id="checkout-form" style="display: none;" class="mt-3 border-top pt-3">
                    <h6 class="fw-bold mb-3">Thông tin giao hàng</h6>
                    <input type="text" id="cus_name" class="form-control mb-2 form-control-sm" placeholder="Họ tên">
                    <input type="text" id="cus_phone" class="form-control mb-2 form-control-sm" placeholder="Số điện thoại">
                    <textarea id="cus_address" class="form-control mb-3 form-control-sm" rows="3" placeholder="Địa chỉ nhận hàng"></textarea>
                    
                    <button class="btn btn-danger w-100 fw-bold" onclick="handleCheckout()">
                        XÁC NHẬN ĐƠN HÀNG
                    </button>
                </div>

                <!-- Nút Đặt Hàng Ngay -->
                <button id="btn-show-form" class="btn btn-success w-100 fw-bold py-2" onclick="showCheckoutForm()">
                    ĐẶT HÀNG NGAY
                </button>
                
                <p class="text-muted mt-3 small text-center">
                    <i class="bi bi-shield-check"></i> Thanh toán an toàn & bảo mật
                </p>
            </div>
        </div>

    </div>
</div>
        <%- include('partials/footer') %>
    </div>

    <!-- Script riêng cho trang giỏ hàng -->
    <script src="/js/cart-page.js"></script>
</body>
</html>